{
  "name": "ai-cs-review-desk",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:pages": "vite build --config vite.github-pages.config.ts",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .wrangler",
    "typecheck": "tsc --noEmit",
    "test:mcp": "node --experimental-strip-types --test mcp-server/**/*.test.ts",
    "test:mcp-worker": "node --experimental-strip-types --test worker/**/*.test.ts",
    "build:mcp-worker": "wrangler deploy --config wrangler.mcp-development.jsonc --dry-run --outdir .wrangler/mcp-development-dry-run",
    "verify:mcp-worker-bundle": "node worker/verify-bundle.mjs",
    "check:mcp-worker": "npm run test:mcp-worker && npm run build:mcp-worker && npm run verify:mcp-worker-bundle",
    "dev:mcp-worker": "wrangler dev --config wrangler.mcp-development.jsonc --local",
    "test:apps-script": "node apps-script/Code.contract.test.cjs",
    "test:web-api": "node --experimental-strip-types --test app/api/cs/policy.test.ts",
    "test:skill": "node plugins/ai-cs/skills/marketplace-cs-monitor/scripts/browser-session-core.test.mjs && node plugins/ai-cs/skills/marketplace-cs-monitor/scripts/report-core.test.mjs && node plugins/ai-cs/skills/marketplace-cs-monitor/scripts/answer-library-core.test.mjs && node plugins/ai-cs/skills/marketplace-cs-monitor/scripts/notion-answer-adapter.test.mjs && node plugins/ai-cs/skills/marketplace-cs-monitor/scripts/sync-client.test.mjs",
    "check": "npm run typecheck && npm run test:skill && npm run test:apps-script && npm run test:web-api && npm run test:mcp && npm run check:mcp-worker && npm run lint && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "jose": "^6.2.10",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@modelcontextprotocol/client": "^2.0.0",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver",
      "workerd"
    ]
  },
  "type": "module"
}
