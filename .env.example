# Copy to an ignored .env.local. Never commit real values.
NODE_ENV=development
AI_CS_PUBLIC_ORIGIN=http://localhost:3000
AI_CS_RESOURCE_URL=http://localhost:3000/mcp

# OAuth/OIDC provider used by the private ChatGPT plugin connection.
AI_CS_OAUTH_ISSUER=https://identity.example.com
AI_CS_OAUTH_JWKS_URL=https://identity.example.com/.well-known/jwks.json
AI_CS_OAUTH_AUDIENCE=https://ai-cs.example.com/mcp
AI_CS_ALLOWED_ORIGINS=https://chatgpt.com

# Verified OAuth subject allowlists. A subject may appear in exactly one list.
AI_CS_DEV_ALLOWED_SUBJECTS=personal-chatgpt-subject
AI_CS_PROD_ALLOWED_SUBJECTS=company-chatgpt-subject

# Development target. Use a test Sheet and test Apps Script deployment only.
AI_CS_DEV_APPS_SCRIPT_URL=https://script.google.com/macros/s/REPLACE_DEV/exec
AI_CS_DEV_APPS_SCRIPT_KEY=REPLACE_WITH_DEV_SECRET

# Production stays disabled until a separately confirmed cutover.
AI_CS_PRODUCTION_ENABLED=false
AI_CS_PROD_APPS_SCRIPT_URL=
AI_CS_PROD_APPS_SCRIPT_KEY=

# Existing review page uses one server-fixed target per deployment.
AI_CS_WEB_ENVIRONMENT=development
CS_PUBLIC_WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The Cloudflare development MCP uses wrangler.mcp-development.jsonc plus an
# ignored .dev.vars copied from .dev.vars.example. It never reads production
# Apps Script values and must keep AI_CS_PRODUCTION_ENABLED=false.
