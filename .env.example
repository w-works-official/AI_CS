# Google Apps Script Web App endpoint. Do not commit the real value.
MARKETPLACE_CS_SYNC_URL=https://script.google.com/macros/s/REPLACE_ME/exec

# Same key stored in Apps Script property CS_API_KEY.
MARKETPLACE_CS_SYNC_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Used for absolute social-preview URLs when deploying outside the default site.
NEXT_PUBLIC_SITE_URL=https://your-deployment.example.com

